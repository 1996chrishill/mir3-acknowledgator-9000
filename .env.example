# Required
MIR3_USERNAME=your_username
MIR3_PASSWORD=your_password
MIR3_BASE_URL=https://yourorg.mir3.com

# Optional
API_PORT=8080
DRY_RUN=false          # true = list what would be acked, ack nothing
LOG_LEVEL=INFO
TZ=America/New_York
# MIR3_TIMEOUT_MS=30000  # per page action
# API_HOST=0.0.0.0       # bind address inside container
# DATA_DIR=/data
