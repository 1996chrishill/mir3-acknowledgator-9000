# Required
MIR3_USERNAME=your_username
MIR3_PASSWORD=your_password
MIR3_BASE_URL=https://yourorg.mir3.com

# Optional
# Comments must be on their own lines: docker run --env-file keeps inline comments as part of the value.
API_PORT=8080
# true = list what would be acked, ack nothing
DRY_RUN=false
LOG_LEVEL=INFO
TZ=America/New_York
# Comma-separated browser origins allowed to call the API (e.g. the frontend). Unset = no CORS headers.
# CORS_ORIGINS=https://mir3-ack.example.com
# Auto-ack job interval, seconds (min 30). The job is started/stopped via the API and is always off after a restart.
# AUTO_ACK_INTERVAL_S=240
# Auto-ack job stops itself after this many seconds (900 = 15 min). 0 = no limit.
# AUTO_ACK_MAX_DURATION_S=900
# Per page action
# MIR3_TIMEOUT_MS=30000
# Bind address inside container
# API_HOST=0.0.0.0
# DATA_DIR=/data
